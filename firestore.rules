rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Listings collection
    match /listings/{listingId} {
      // Anyone can read listings (public website)
      allow read: if true;

      // Only the designated admin account can write
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == "dularame@gmail.com";
    }

    // Deny access to all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
